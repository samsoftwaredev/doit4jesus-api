{
  "name": "doit4jesus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build  --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write . --config .prettierrc.js",
    "format:check": "prettier --check . --config .prettierrc.js",
    "typecheck": "tsc --noEmit --project tsconfig.verify.json",
    "check:outdated": "node scripts/check-outdated-packages.mjs",
    "check:outdated:strict": "node scripts/check-outdated-packages.mjs --strict",
    "verify:commit": "pnpm run typecheck && pnpm run format && pnpm run lint && pnpm test && pnpm run check:outdated",
    "verify:push": "pnpm run typecheck && pnpm run format:check && pnpm run lint:check && pnpm test && pnpm run check:outdated:strict",
    "import:spanish-bible": "node scripts/import-spanish-bible.mjs",
    "import:usccb-lectionary": "node scripts/import-usccb-lectionary.mjs",
    "import:usccb-calendar": "node scripts/import-usccb-calendar-text.mjs",
    "build:username-profanity": "node scripts/build-username-profanity-data.mjs",
    "export": "next export",
    "prepare": "husky",
    "test": "jest --watch=false --passWithNoTests",
    "test-coverage": "jest --coverage",
    "test:watch": "jest"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@mui/material-nextjs": "7.3.9",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "moment": "2.30.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-charts": "3.0.0-beta.57",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "4.3.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.6",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.3.3",
    "ts-node": "10.9.2"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
